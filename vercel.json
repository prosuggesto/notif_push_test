{
  "rewrites": [
    { "source": "/entreprise", "destination": "/entreprise.html" },
    { "source": "/fetars", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
